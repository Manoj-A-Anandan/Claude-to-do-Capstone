{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "./.github/hooks/scripts/session-start.sh",
        "powershell": "./.github/hooks/scripts/session-start.ps1",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "./.github/hooks/scripts/pre-tool-guard.sh",
        "powershell": "./.github/hooks/scripts/pre-tool-guard.ps1",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "./.github/hooks/scripts/post-tool-docsync.sh",
        "powershell": "./.github/hooks/scripts/post-tool-docsync.ps1",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "./.github/hooks/scripts/session-end.sh",
        "powershell": "./.github/hooks/scripts/session-end.ps1",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
